# Drizzle
# Replace with your DB credentials!
DATABASE_URL="postgres://postgres:postgres@localhost:5432/kmc_advent"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Google ログイン（必須。学校の Google アカウントでログインする）
# Google Cloud Console → 認証情報 → OAuth クライアントID(ウェブ) で作成。
# 承認済みのリダイレクトURI: <ORIGIN>/api/auth/callback/google （localhost 以外は https のみ）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 本番(docker compose)用のDBパスワード。サーバーでは必ず変更する。
POSTGRES_PASSWORD="postgres"

# Slack 通知（任意）。その日の記事が公開されたらチャンネルに投稿する。
# slack/manifest.yml からアプリを作り、Bot User OAuth Token (xoxb-...) とチャンネルIDを入れる。
SLACK_BOT_TOKEN=""
SLACK_CHANNEL_ID=""
# この時刻(JST)より前は投稿しない（0 にすると 0 時ちょうどに投稿）
SLACK_POST_HOUR="8"

# Vercel Cron 用（Vercel にデプロイするときだけ）。openssl rand -hex 32 などで作る。
CRON_SECRET=""
